  {
   "description": "Проверка корректности типов комнат. Тип комнаты должен быть одним из: classroom, lab, lecture_hall, office.",
   "dimension": "validity",
   "sql": "SELECT id FROM rooms WHERE LOWER(type) NOT IN ('classroom', 'lab', 'lecture_hall', 'office');",

  {
   "description": "Проверка формата даты рождения в таблице people. Даты должны быть в формате ISO 8601.",
   "dimension": "validity",
   "sql": "SELECT id FROM people WHERE TRY_CAST(date_of_birth AS DATE) IS NULL AND date_of_birth <> '';",
   "table": "people"
  },
  {
   "description": "Проверка обязательных полей в адресах. Все поля адреса должны быть заполнены.",
   "dimension": "completeness",
   "sql": "SELECT id FROM addresses WHERE city IS NULL OR country IS NULL OR postal_code IS NULL OR state IS NULL OR street IS NULL;",
   "table": "addresses"
  },
  {
   "description": "Проверка уникальности ISBN книг. ISBN должны быть уникальными.",
   "dimension": "uniqueness",
   "sql": "SELECT isbn FROM books GROUP BY isbn HAVING COUNT(*) > 1;",
   "table": "books"
  },
  {
   "description": "Проверка корректности пола человека. Пол должен быть одним из: female, male, non_binary, unspecified.",
   "dimension": "validity",
   "sql": "SELECT id FROM people WHERE LOWER(gender) NOT IN ('female', 'male', 'non_binary', 'unspecified');",
   "table": "people"
  },
  {
   "description": "Проверка корректности ссылок между людьми и адресами. Все люди должны иметь корректный внешний ключ на адрес.",
   "dimension": "referential_integrity",
   "sql": "SELECT p.id FROM people p LEFT JOIN addresses a ON p.address_id = a.id WHERE a.id IS NULL;",
   "table": "people"
  },
  {
   "description": "Проверка наличия обязательного названия курса. Название курса не может быть пустым.",
   "dimension": "completeness",
   "sql": "SELECT id FROM courses WHERE TRIM(title) = '' OR title IS NULL;",
   "table": "courses"
  },
  {
   "description": "Проверка корректности оценок экзаменов. Оценки должны быть в пределах от 0 до максимального количества баллов экзамена.",
   "dimension": "validity",
   "sql": "SELECT er.id FROM exam_results er INNER JOIN exams e ON er.exam_id = e.id WHERE er.score < 0 OR er.score > e.max_points;",
   "table": "exam_results"
  },
  {
   "description": "Проверка логической последовательности дат выдачи и истечения срока действия карты библиотеки. Дата окончания срока действия карты должна следовать после даты её выпуска.",
   "dimension": "validity",
   "sql": "SELECT id FROM library_cards WHERE TRY_CAST(expiry_date AS DATE) <= TRY_CAST(issue_date AS DATE);",
   "table": "library_cards"
  },
  {
   "description": "Проверка правильности общей суммы счета. Общая сумма счета должна соответствовать общей сумме позиций счета.",
   "dimension": "accuracy",
   "sql": "SELECT i.id FROM invoices i WHERE ABS(i.total_amount - SUM(ii.amount)) > 0.01 AND EXISTS (SELECT 1 FROM invoice_items ii WHERE ii.invoice_id = i.id);",
   "table": "invoices"
  },
  {
   "description": "Проверка отсутствия отрицательных сумм платежей. Платежи не могут быть отрицательными.",
   "dimension": "validity",
   "sql": "SELECT id FROM payments WHERE amount < 0;",
   "table": "payments"

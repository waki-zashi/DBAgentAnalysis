   "sql": "SELECT id FROM assignments WHERE TRIM(description) = '' OR description IS NULL;",
   "table": "assignments"
  },
  {
   "description": "Проверка корректности количества кредитов программы обучения. Количество кредитов должно быть положительным числом.",
   "dimension": "validity",
   "sql": "SELECT id FROM programs WHERE credits_required <= 0;",
   "table": "programs"
  },
  {

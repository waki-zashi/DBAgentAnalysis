  {
   "description": "Проверка корректности формата даты рождения в таблице people. -\n                 Даты должны быть корректно отформатированы и не быть пустыми.|\n        ",
   "dimension": "validity",
   "sql": "SELECT id FROM people WHERE date_of_birth IS NULL OR date_of_birth <> try_cast(date_of_birth AS DATE);",
   "table": "people"
  },
  {
   "description": "Проверка наличия обязательных полей в таблице addresses. -\n             Все поля кроме state должны быть заполнены.|\n        ",
   "dimension": "completeness",
   "sql": "SELECT id FROM addresses WHERE city IS NULL OR country IS NULL OR street IS NULL;",
   "table": "addresses"
  },
  {
   "description": "Проверка уникальности кода отдела в таблице departments. -\n             Код отдела должен быть уникальным.|\n        ",
   "dimension": "uniqueness",
   "sql": "SELECT code, COUNT(*) FROM departments GROUP BY code HAVING COUNT(*) > 1;",
   "table": "departments"
  },
  {
   "description": "Проверка соответствия количества кредитов курсу в таблице courses. -\n             Количество кредитов должно быть положительным числом.|\n        ",
   "dimension": "validity",
   "sql": "SELECT id FROM courses WHERE credits IS NULL OR credits < 1;",
   "table": "courses"
  },
  {
   "description": "Проверка статуса студента в таблице students. -\n             Статус студента должен быть одним из: enrolled, graduated, withdrawn.|\n        ",
   "dimension": "validity",
   "sql": "SELECT id FROM students WHERE status NOT IN ('enrolled', 'graduated', 'withdrawn');",
   "table": "students"
  },
  {
   "description": "Проверка отсутствия пустых значений в столбце rank в таблице instructors. -\n             У преподавателей должен быть указан ранг.|\n        ",
   "dimension": "completeness",
   "sql": "SELECT id FROM instructors WHERE rank IS NULL;",
   "table": "instructors"
  },
  {
   "description": "Проверка отсутствия пустых значений в столбце name в таблице programs. -\n             Название программы должно быть указано.|\n        ",
   "dimension": "completeness",
   "sql": "SELECT id FROM programs WHERE name IS NULL;",
   "table": "programs"
  },
  {
   "description": "Проверка корректности формата даты в таблице exams. -\n             Даты экзаменов должны быть корректно отформатированы.|\n        ",
   "dimension": "validity",
   "sql": "SELECT id FROM exams WHERE exam_date IS NOT NULL AND exam_date <> try_cast(exam_date AS TIMESTAMP);",
   "table": "exams"
  }

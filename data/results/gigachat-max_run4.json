  {
   "description": "Проверить корректность формата даты рождения. Найти записи с неверно заданной датой рождения.",
   "dimension": "validity",
   "sql": "SELECT id\nFROM people\nWHERE TRY_CAST(date_of_birth AS DATE) IS NULL AND date_of_birth != '';",
   "table": "people"
  },
  {
   "description": "Найти записи с неверно заданным полом. Пол должен быть одним из допустимых вариантов: female, male, non_binary, unspecified.",
   "dimension": "validity",
   "sql": "SELECT id\nFROM people\nWHERE LOWER(gender) NOT IN ('female', 'male', 'non_binary', 'unspecified');",
   "table": "people"
  },
  {
   "description": "Обнаружить секции с неопределённым количеством мест. Вместимость аудитории всегда должна быть известна заранее.",
   "dimension": "completeness",
   "sql": "SELECT id\nFROM sections\nWHERE capacity IS NULL;",
   "table": "sections"
  },
  {
   "description": "Проверить соответствие внешних ключей в таблице sections. Секции должны ссылаться на существующие курсы, комнаты и преподавателей.",
   "dimension": "referential_integrity",
   "sql": "SELECT s.id\nFROM sections s\nLEFT JOIN courses c ON s.course_id = c.id\nLEFT JOIN rooms r ON s.room_id = r.id\nLEFT JOIN instructors i ON s.instructor_id = i.id\nWHERE c.id IS NULL OR r.id IS NULL OR i.id IS NULL;",
   "table": "sections"
  },
  {
   "description": "Поиск счетов с некорректным форматом даты. Даты должны быть в формате ISO.",
   "dimension": "validity",
   "sql": "SELECT id\nFROM invoices\nWHERE TRY_CAST(due_date AS DATE) IS NULL AND due_date != '' OR TRY_CAST(issue_date AS DATE) IS NULL AND issue_date != '';",
   "table": "invoices"
  },
  {
   "description": "Проверить соответствие общей суммы счета и суммы позиций в счете. Сумма позиций должна совпадать с общей суммой счета.",
   "dimension": "accuracy",
   "sql": "SELECT inv.id\nFROM invoices inv\nJOIN (\n    SELECT invoice_id, SUM(amount) AS sum_items\n    FROM invoice_items\n    GROUP BY invoice_id\n) ii ON inv.id = ii.invoice_id\nWHERE abs(inv.total_amount - ii.sum_items) > 0.01;",
   "table": "invoices"
  },
  {
   "description": "Проверить соответствие внешнего ключа student_id в таблице enrollments с существующими студентами. Записи должны ссылаться на существующих студентов.",
   "dimension": "referential_integrity",
   "sql": "SELECT e.id\nFROM enrollments e\nLEFT JOIN students st ON e.student_id = st.id\nWHERE st.id IS NULL;",
   "table": "enrollments"
  }
 ],

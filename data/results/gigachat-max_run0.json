   "description": "Найти людей без имени или фамилии.",
   "dimension": "Completeness",
   "sql": "SELECT id \\nFROM people \\nWHERE first_name IS NULL OR last_name IS NULL;",
   "table": "people"
  },
  {
   "description": "Найти людей без электронных почт.",
   "dimension": "Completeness",
   "sql": "SELECT id \\nFROM people \\nWHERE email IS NULL OR TRIM(email) = '';",
   "table": "people"
  },
  {
   "description": "Найти людей с неверной датой рождения.",
   "dimension": "Validity",
   "sql": "SELECT id \\nFROM people \\nWHERE TRY_CAST(date_of_birth AS DATE) < '1900-01-01' OR TRY_CAST(date_of_birth AS DATE) > CURRENT_DATE();",
   "table": "people"
  },
  {
   "description": "Найти людей с неверным полом.",
   "dimension": "Validity",
   "sql": "SELECT id \\nFROM people \\nWHERE gender NOT IN ('female', 'male', 'non_binary', 'unspecified');",
   "table": "people"
  },
  {
   "description": "Найти курсы с некорректным количеством кредитов.",
   "dimension": "Completeness",
   "sql": "SELECT id \\nFROM courses \\nWHERE credits IS NULL OR credits <= 0;",
   "table": "courses"
  },
  {
   "description": "Найти одинаковые курсы с разными ID.",
   "dimension": "Uniqueness",
   "sql": "SELECT c1.id \\nFROM courses c1 \\nWHERE EXISTS (\\n    SELECT 1 \\n    FROM courses c2 \\n    WHERE c1.code = c2.code AND c1.title = c2.title AND c1.id <> c2.id\\n);",
   "table": "courses"
  },
  {
   "description": "Найти студентов с неправильным статусом.",
   "dimension": "Validity",
   "sql": "SELECT id \\nFROM students \\nWHERE status NOT IN ('active', 'graduated', 'suspended');",
   "table": "students"
  },
  {
   "description": "Найти студентов младше установленного возраста при поступлении.",
   "dimension": "Validity",
   "sql": "SELECT st.id \\nFROM students st \\nWHERE DATE_PART('year', AGE(st.enrollment_date)) - DATE_PART('year', AGE(st.date_of_birth)) < 16;",
   "table": "students"
  },
  {
   "description": "Найти счета с нулевыми или отрицательными суммами.",
   "dimension": "Validity",
   "sql": "SELECT id \\nFROM invoices \\nWHERE total_amount <= 0;",
   "table": "invoices"
  },
  {
   "description": "Найти счета с неправильным расчетом общей суммы.",
   "dimension": "Accuracy",
   "sql": "SELECT inv.id \\nFROM invoices inv \\nWHERE inv.total_amount != COALESCE((SELECT SUM(ii.amount) FROM invoice_items ii WHERE ii.invoice_id = inv.id), 0);",
   "table": "invoices"
  },
  {
   "description": "Найти клубы без указанного бюджета или с нулевым бюджетом.",
   "dimension": "Completeness",
   "sql": "SELECT id \\nFROM clubs \\nWHERE budget IS NULL OR budget <= 0;",
   "table": "clubs"
  },
  {
   "description": "Найти кружки без названий.",
   "dimension": "Completeness",
   "sql": "SELECT id \\nFROM clubs \\nWHERE name IS NULL OR TRIM(name) = '';",
   "table": "clubs"
  }
